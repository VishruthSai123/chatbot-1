# NextAuth Secret: generate a random secret via `openssl rand -base64 32`
AUTH_SECRET=****

# Supabase PostgreSQL Database (Session Pooler URI on port 5432)
POSTGRES_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres

# Google Gemini API Key: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=****

# Supabase Storage & API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=****
SUPABASE_SERVICE_ROLE_KEY=****

# Optional fallback or legacy
BLOB_READ_WRITE_TOKEN=****
REDIS_URL=****

