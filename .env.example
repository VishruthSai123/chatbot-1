# NextAuth Secret: generate a random secret via `openssl rand -base64 32`
AUTH_SECRET=****

# Supabase PostgreSQL Database (Session Pooler URI on port 5432)
POSTGRES_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
# Transaction Pooler URI on port 6543. Used by the app at runtime; migrations use POSTGRES_URL.
POSTGRES_TRANSACTION_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres
# Preview builds skip migrations unless this is true and the Preview database is separate.
PREVIEW_DATABASE_CONFIRMED=false
# Set to false to skip migrations for one build. Never use production credentials in Preview.
RUN_DB_MIGRATIONS=

# Gemini API key (the default provider): https://aistudio.google.com/apikey
# Either name works; GEMINI_API_KEY wins when both are set.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Rolling rotation: primary -> *_NEXT -> GEMINI_API_KEYS.
# Keep the old key in *_NEXT while validating a replacement, then remove it.
GEMINI_API_KEY_NEXT=
GEMINI_API_KEYS=

# Optional OpenRouter fallback. Disabled unless AI_FALLBACK_PROVIDER=openrouter.
# It is never the default and never appears in the model selector.
AI_FALLBACK_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=google/gemini-3.5-flash-lite

# Optional: point the Google provider at a proxy or a local mock.
GOOGLE_GENERATIVE_AI_API_BASE=

# Optional self-hosted SearXNG JSON endpoint, e.g. https://search.example.com
SEARXNG_URL=

# Supabase Storage & API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=****
SUPABASE_SERVICE_ROLE_KEY=****

# Storage provider: supabase (default) or r2.
STORAGE_PROVIDER=supabase
# Cloudflare R2 (S3-compatible). 10 GB free, zero egress.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Transactional email for verification and password reset.
# Resend is used when RESEND_API_KEY and EMAIL_FROM are set.
RESEND_API_KEY=
EMAIL_FROM="Spire <no-reply@example.com>"
EMAIL_REPLY_TO=
# Absolute origin used in auth email links. Falls back to the request origin.
APP_URL=https://chatbot-1-beige.vercel.app

# Optional fallback or legacy
REDIS_URL=****

# Free-tier enforcement. These are not paywall switches: they are the free plan.
CHAT_QUOTA_ENABLED=true
# Route free users to Gemini 3.1 Flash-Lite with a 4k context budget.
MODEL_ROUTING_ENABLED=false
# Run cheap image operations in the browser. Requires R2 CORS if storage is R2.
NEXT_PUBLIC_CLIENT_IMAGE_TOOLS=false
# Run PDF page extraction in the browser with pdf-lib. Requires R2 CORS.
NEXT_PUBLIC_CLIENT_PDF_TOOLS=false
# Hosted tool, download and storage limits. Persists stay exempt.
TOOLS_QUOTA_ENABLED=true
DOWNLOAD_QUOTA_ENABLED=true
UPLOAD_QUOTA_ENABLED=true
# Accountless Spire quick answers. The monthly allowance is visible; the daily
# and weekly caps are fair-use guardrails. Costs are tiny, so the default cap
# only protects against abuse. Set the cap to 0 to disable it.
QUICK_ANSWER_ENABLED=true
QUICK_ANSWER_MONTHLY_LIMIT=150
QUICK_ANSWER_WEEKLY_LIMIT=50
QUICK_ANSWER_DAILY_LIMIT=10
QUICK_ANSWER_IP_DAILY_LIMIT=40
QUICK_ANSWER_DAILY_COST_CAP_USD=2
# Shared secret for the scheduled /api/maintenance cleanup
CRON_SECRET=****
# Optional short-lived bearer for one-off maintenance actions. Remove after use.
MAINTENANCE_CLEANUP_TOKEN=
